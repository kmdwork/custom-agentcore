{
  "openapi": "3.0.3",
  "info": {
    "title": "Laravel Agent Tools",
    "version": "1.0.0",
    "description": "Laravelの顧客情報をSanctum Bearerトークンで検索するAgent専用API"
  },
  "servers": [
    {
      "url": "https://laravel.example.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "SanctumBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Laravel Sanctum"
      }
    }
  },
  "security": [
    {
      "SanctumBearer": []
    }
  ],
  "paths": {
    "/api/agent-tools/customers/search": {
      "post": {
        "operationId": "searchCustomers",
        "summary": "顧客を検索する",
        "description": "名前、会社名、電話番号などのキーワードで顧客を検索します。メールアドレスは返しません。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "顧客検索キーワード",
                    "maxLength": 100
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "description": "取得件数",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 10
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "検索成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sanctumトークンが無効"
          },
          "403": {
            "description": "必要なAbilityがない"
          },
          "422": {
            "description": "入力値が不正"
          },
          "429": {
            "description": "リクエスト回数超過"
          }
        }
      }
    }
  }
}
