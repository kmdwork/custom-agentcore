{
  "name": "myruntime",
  "version": 2,
  "migratedFrom": "v1",
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "myruntime"
  },
  "runtimes": [
    {
      "name": "MyAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/MyAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "AIRCON_API_URL",
          "value": "<IP_ENDPOINT_URL>"
        },
        {
          "name": "AIRCON_ALLOW_INSECURE_HTTP",
          "value": "1"
        },
        {
          "name": "GENERATED_FILES_BUCKET",
          "value": "<S3_BUCKET_NAME>"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "iam/generated-files-s3.json"
      ],
      "connections": [
        {
          "id": "managedBrowser",
          "to": {
            "type": "browser"
          }
        },
        {
          "id": "managedCodeInterpreter",
          "to": {
            "type": "codeInterpreter"
          }
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "MyAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "strands-app-tools",
      "protocolType": "None",
      "description": "Gateway for strands-app-tools",
      "targets": [
        {
          "name": "web-search-tool",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "parameterValues": {
                "maxResults": 10
              }
            }
          ]
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": [],
  "payments": []
}