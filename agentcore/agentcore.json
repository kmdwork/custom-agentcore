{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "myruntime",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "myruntime"
  },
  "runtimes": [
    {
      "name": "MyAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/MyAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AIRCON_GATEWAY_URL",
          "value": "<AIRCON_GATEWAY_URL>"
        }
      ],
      "connections": [
        {
          "id": "managedBrowser",
          "to": {
            "type": "browser"
          }
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "MyAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [
    {
      "type": "AgentCoreKnowledgeBase",
      "name": "MyKnowledgeBase",
      "dataSources": [
        {
          "type": "S3",
          "uri": "s3://<S3_BUCKET_NAME>"
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "strands-app-tools",
      "protocolType": "None",
      "description": "Gateway for strands-app-tools",
      "targets": [
        {
          "name": "myruntime-MyKnowledgeBase",
          "targetType": "connector",
          "connectorId": "bedrock-knowledge-bases",
          "configurations": [
            {
              "name": "AgenticRetrieveStream",
              "description": "Streaming endpoint for agentic retrieval from knowledge bases. Performs multi-step retrieval with planning and returns results as a stream of events.",
              "parameterValues": {
                "retrievers": [
                  {
                    "configuration": {
                      "knowledgeBase": {
                        "knowledgeBaseId": "<BEDROCK_KNOWLEDGE_BASE_ID>"
                      }
                    }
                  }
                ],
                "agenticRetrieveConfiguration": {
                  "foundationModelType": "MANAGED",
                  "rerankingModelType": "MANAGED"
                }
              },
              "parameterOverrides": []
            },
            {
              "name": "Retrieve",
              "description": "Queries a knowledge base and retrieves information from it.",
              "parameterValues": {
                "knowledgeBaseId": "<BEDROCK_KNOWLEDGE_BASE_ID>"
              },
              "parameterOverrides": []
            }
          ]
        },
        {
          "name": "aircon-cloudflare-api",
          "targetType": "passthrough",
          "outboundAuth": {
            "type": "JWT_PASSTHROUGH"
          },
          "passthrough": {
            "endpoint": "https://strands-kamada-hono.kmdworksnative.workers.dev/api/agent/aircon",
            "protocolType": "CUSTOM"
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
