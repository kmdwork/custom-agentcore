{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "browserVerification",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "browserVerification"
  },
  "runtimes": [
    {
      "name": "browserVerification",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/browserVerification/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "WEB_SEARCH_GATEWAY_URL",
          "value": "<WEB_SEARCH_GATEWAY_URL>"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "WebSearchGateway",
      "protocolType": "MCP",
      "description": "Gateway for WebSearchGateway",
      "targets": [
        {
          "name": "WebSearchTarget",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "description": "",
              "parameterValues": {
                "domainFilter": {
                  "exclude": [
                    "example.com",
                    "example.org"
                  ]
                }
              },
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
